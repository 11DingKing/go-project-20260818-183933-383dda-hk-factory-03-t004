# sitesync environment overrides. Every value mirrors a config.example.yaml
# field and is applied on top of the YAML config when present.
# Copy to .env and export before running: `set -a && . ./.env && set +a`.

# HTTP server
SITESYNC_SERVER_PORT=48557

# SQLite storage (created under data_dir)
SITESYNC_STORAGE_DATA_DIR=./data
SITESYNC_STORAGE_DB_FILE=sitesync.db

# Background scheduler intervals
SITESYNC_SCHEDULER_POLL_INTERVAL=8h
SITESYNC_SCHEDULER_ESCALATOR_INTERVAL=1h

# Offline backfill replay window (hours)
SITESYNC_BACKFILL_WINDOW_HOURS=168

# Structured logging level: debug, info, warn, error
SITESYNC_LOG_LEVEL=info
